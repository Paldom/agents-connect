# Firebase web app config as one JSON line (Firebase console → Project settings → Your apps → SDK setup, or `firebase apps:sdkconfig WEB <app-id>`).
VITE_FIREBASE_CONFIG={"projectId":"<project-id>","appId":"<app-id>","apiKey":"<web-api-key>","authDomain":"<project-id>.firebaseapp.com","storageBucket":"<project-id>.firebasestorage.app","messagingSenderId":"<sender-id>"}
# Hub API base. Defaults to /api (Firebase Hosting rewrite). For the local emulator:
VITE_API_URL=http://127.0.0.1:5001/<project-id>/europe-west1/api
# Web Push certificate key pair (Firebase console → Project settings → Cloud Messaging → Web Push certificates).
VITE_FIREBASE_VAPID_KEY=
# Set to 1 to use the Auth (9099) and Firestore (8090) emulators.
VITE_USE_EMULATORS=0
